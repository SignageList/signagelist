{{- $products := slice -}}
{{- range $slug, $p := .Site.Data.products -}}
  {{- $products = $products | append (merge $p (dict "url" (printf "%sproducts/%s/" $.Site.BaseURL $slug))) -}}
{{- end -}}
{{- $out := dict
  "name" .Site.Title
  "description" .Site.Params.description
  "url" .Site.BaseURL
  "license" "https://opendatacommons.org/licenses/odbl/1-0/"
  "attribution" "SignageList dataset © 514sid and contributors, licensed under ODbL v1.0"
  "generated" (now.Format "2006-01-02")
  "count" (len $products)
  "documentation" (printf "%sllms.txt" .Site.BaseURL)
  "products" (sort $products "name")
-}}
{{- $out | jsonify (dict "indent" "  ") -}}
